# Tatum (dashboard.tatum.io) — used server-side for Sui Mainnet gRPC
TATUM_API_KEY=
# Walrus Memory (memory.walrus.xyz/dashboard -> Delegate keys)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Your Sui address that receives USDC
SUI_PAYEE_ADDRESS=
# Optional: owner passcode required for writes (payer-facing /verify-payment stays public)
APP_PASSCODE=

# Optional: testnet mode (Tatum testnet gateway, Circle testnet USDC, Payment Kit testnet)
# SUI_NETWORK=testnet
# MEMWAL_NS_PREFIX=ic:test:

# --- Optional ---------------------------------------------------------------
# Factur-X e-invoice seller identity (embedded XML + /pay/:id/invoice.xml; hidden when unset)
# SELLER_NAME=Your legal name
# SELLER_COUNTRY=ID          # ISO 3166 alpha-2
# SELLER_VAT_ID=
# Walrus PDF receipts and Walrus Site (a Sui key that holds WAL + SUI)
# WALRUS_STORAGE_KEY=suiprivkey...
# Gas sponsor for client payments (defaults to WALRUS_STORAGE_KEY)
# GAS_SPONSOR_KEY=suiprivkey...
# SPONSOR_MAX_MIST=20000000
# MPP (Machine Payments Protocol) charge endpoint
# MPP_SECRET_KEY=
# AI reminder drafts through Vercel AI Gateway (template drafts without it)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=
# Daily Vercel cron (/api/chaser/cron/sync)
# CRON_SECRET=
# Private mode: owner data behind APP_PASSCODE too (see README)
# PRIVATE_READS=1
# Throwaway local demos only: allow owner writes without a passcode (every write is a permanent Walrus memory)
# ALLOW_OPEN_WRITES=1
# Private Payment Kit registry (longer record lifetime)
# PAYMENT_REGISTRY=
# Local E2E server: multiply the per-IP rate limits
# RATE_LIMIT_SCALE=50

# --- Email reminders from your own mailbox (optional; the "Send by email" button appears only when set) ---
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Your Name <you@gmail.com>"

# --- Xero accounting sync (optional; "Connect Xero" appears only when all are set) ---
# Create a Web app at https://developer.xero.com/app/manage with redirect URI
#   https://<your-domain>/api/chaser/xero/callback
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://<your-domain>/api/chaser/xero/callback
# Token storage (the app has no database): Upstash Redis from the Vercel Marketplace sets these
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
